{
	"info": {
		"_postman_id": "d6d8f721-e03f-4586-8994-d672477bf350",
		"name": "Book ISBN Numbers with Scripts",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "31554447"
	},
	"item": [
		{
			"name": "Is Valid ISBN13 Number",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Статус 200\", function () { pm.response.to.have.status(200); });",
							"pm.test(\"Content-Type xml\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"xml\"); });",
							"pm.test(\"Містить назву методу\", function () { pm.expect(pm.response.text()).to.include(\"IsValidISBN13\"); });",
							"pm.test(\"Містить ISBN\", function () { pm.expect(pm.response.text()).to.include(\"978-1-4612-9090-2\"); });",
							"pm.test(\"XML має Envelope\", function () { pm.expect(pm.response.text()).to.include(\"Envelope\"); });",
							"pm.test(\"Відповідь не порожня\", function () { pm.expect(pm.response.text().length).to.be.above(0); });",
							"pm.test(\"Є true або false\", function () { pm.expect(pm.response.text()).to.match(/<.*Result>(true|false)<\\/.*Result>/); });",
							"pm.test(\"Очікуване значення\", function () { pm.expect(pm.response.responseTime).to.be.below(1000); });",
							"pm.test(\"Без протилежного значення\", function () { pm.response.to.be.xml; });",
							"pm.test(\"XML формат\", function () { pm.expect(pm.response.status).to.eql(\"OK\"); });"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "text/xml; charset=utf-8",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <IsValidISBN13 xmlns=\"http://webservices.daehosting.com/ISBN\">\n      <sISBN>978-1-4612-9090-2</sISBN>\n    </IsValidISBN13>\n  </soap:Body>\n</soap:Envelope>"
				},
				"url": {
					"raw": "http://webservices.daehosting.com/services/isbnservice.wso",
					"protocol": "http",
					"host": [
						"webservices",
						"daehosting",
						"com"
					],
					"path": [
						"services",
						"isbnservice.wso"
					]
				}
			},
			"response": []
		},
